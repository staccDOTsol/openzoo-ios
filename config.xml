<?xml version='1.0' encoding='utf-8'?>
<widget id="fun.openzoo.ios" version="1.0.1" ios-CFBundleVersion="2" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>OpenZoo</name>
    <description>OpenZoo iOS — App Store subscriptions first, grokui-style chat. No Stripe webview. No MWA.</description>
    <author href="https://github.com/staccDOTsol/openzoo-ios">
        OpenZoo
    </author>

    <!-- Local shell owns the wallet, loads the app in an iframe -->
    <content src="index.html" />

    <access origin="https://zoo.openzoo.fun" />
    <allow-navigation href="https://zoo.openzoo.fun/*" />
    <allow-navigation href="https://*.openzoo.fun/*" />
    <access origin="https://x402-tokens.fly.dev" />
    <access origin="https://x402.accrue.fund" />
    <access origin="https://api.mainnet-beta.solana.com" />
    <access origin="https://solana-rpc.publicnode.com" />
    <access origin="https://solflare.com" />

    <allow-intent href="https://*/*" />
    <allow-intent href="phantom://*" />
    <allow-intent href="solflare://*" />

    <preference name="Fullscreen" value="false" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#0a0a12" />
    <preference name="StatusBarStyle" value="lightcontent" />
    <preference name="KeepRunning" value="true" />
    <preference name="Orientation" value="default" />
    <preference name="BackgroundColor" value="0xff0a0a12" />
    <preference name="SplashScreenDelay" value="0" />
    <preference name="FadeSplashScreen" value="false" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="DisallowOverscroll" value="true" />

    <!-- Android icons from upstream CordovaSeeker remain; this product is iOS. -->
    <platform name="android">
        <icon density="ldpi" src="res/icon/android/ldpi.png" />
        <icon density="mdpi" src="res/icon/android/mdpi.png" />
        <icon density="hdpi" src="res/icon/android/hdpi.png" />
        <icon density="xhdpi" src="res/icon/android/xhdpi.png" />
        <icon density="xxhdpi" src="res/icon/android/xxhdpi.png" />
        <icon density="xxxhdpi" src="res/icon/android/xxxhdpi.png" />
    </platform>

    <platform name="ios">
        <preference name="deployment-target" value="15.0" />
        <preference name="UseSwiftLanguageVersion" value="5" />
        <preference name="SwiftVersion" value="5" />
        <hook type="after_prepare" src="hooks/ios-swift-version.js" />
        <preference name="scheme" value="app" />
        <preference name="hostname" value="localhost" />

        <icon src="res/icon/ios/icon-20.png" width="20" height="20" />
        <icon src="res/icon/ios/icon-29.png" width="29" height="29" />
        <icon src="res/icon/ios/icon-40.png" width="40" height="40" />
        <icon src="res/icon/ios/icon-50.png" width="50" height="50" />
        <icon src="res/icon/ios/icon-57.png" width="57" height="57" />
        <icon src="res/icon/ios/icon-58.png" width="58" height="58" />
        <icon src="res/icon/ios/icon-60.png" width="60" height="60" />
        <icon src="res/icon/ios/icon-72.png" width="72" height="72" />
        <icon src="res/icon/ios/icon-76.png" width="76" height="76" />
        <icon src="res/icon/ios/icon-80.png" width="80" height="80" />
        <icon src="res/icon/ios/icon-87.png" width="87" height="87" />
        <icon src="res/icon/ios/icon-100.png" width="100" height="100" />
        <icon src="res/icon/ios/icon-114.png" width="114" height="114" />
        <icon src="res/icon/ios/icon-120.png" width="120" height="120" />
        <icon src="res/icon/ios/icon-144.png" width="144" height="144" />
        <icon src="res/icon/ios/icon-152.png" width="152" height="152" />
        <icon src="res/icon/ios/icon-167.png" width="167" height="167" />
        <icon src="res/icon/ios/icon-180.png" width="180" height="180" />
        <icon src="res/icon/ios/icon-1024.png" width="1024" height="1024" />

        <config-file parent="CFBundleURLTypes" target="*-Info.plist">
            <array>
                <dict>
                    <key>CFBundleURLName</key>
                    <string>fun.openzoo.ios</string>
                    <key>CFBundleURLSchemes</key>
                    <array>
                        <string>openzoo</string>
                    </array>
                </dict>
            </array>
        </config-file>
        <config-file parent="LSApplicationQueriesSchemes" target="*-Info.plist">
            <array>
                <string>phantom</string>
                <string>solflare</string>
            </array>
        </config-file>
        <config-file parent="NSAppTransportSecurity" target="*-Info.plist">
            <dict>
                <key>NSAllowsLocalNetworking</key>
                <true/>
                <key>NSAllowsArbitraryLoadsInWebContent</key>
                <true/>
                <key>NSExceptionDomains</key>
                <dict>
                    <key>zoo.openzoo.fun</key>
                    <dict>
                        <key>NSIncludesSubdomains</key>
                        <true/>
                        <key>NSExceptionRequiresForwardSecrecy</key>
                        <true/>
                        <key>NSExceptionMinimumTLSVersion</key>
                        <string>TLSv1.2</string>
                    </dict>
                    <key>x402-tokens.fly.dev</key>
                    <dict>
                        <key>NSIncludesSubdomains</key>
                        <true/>
                        <key>NSExceptionRequiresForwardSecrecy</key>
                        <true/>
                        <key>NSExceptionMinimumTLSVersion</key>
                        <string>TLSv1.2</string>
                    </dict>
                    <key>accrue.fund</key>
                    <dict>
                        <key>NSIncludesSubdomains</key>
                        <true/>
                        <key>NSExceptionRequiresForwardSecrecy</key>
                        <true/>
                        <key>NSExceptionMinimumTLSVersion</key>
                        <string>TLSv1.2</string>
                    </dict>
                    <key>solana.com</key>
                    <dict>
                        <key>NSIncludesSubdomains</key>
                        <true/>
                        <key>NSExceptionRequiresForwardSecrecy</key>
                        <true/>
                        <key>NSExceptionMinimumTLSVersion</key>
                        <string>TLSv1.2</string>
                    </dict>
                    <key>publicnode.com</key>
                    <dict>
                        <key>NSIncludesSubdomains</key>
                        <true/>
                        <key>NSExceptionRequiresForwardSecrecy</key>
                        <true/>
                        <key>NSExceptionMinimumTLSVersion</key>
                        <string>TLSv1.2</string>
                    </dict>
                </dict>
            </dict>
        </config-file>
    </platform>
</widget>
