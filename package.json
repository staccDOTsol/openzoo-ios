{
  "name": "fun.openzoo.ios",
  "displayName": "OpenZoo",
  "version": "1.0.0",
  "description": "OpenZoo iOS — App Store subscriptions first, grokui-style chat. StoreKit 2 IAP. No Stripe webview. No MWA.",
  "main": "index.js",
  "scripts": {
    "platform:ios": "cordova platform add ios",
    "build": "cordova build ios",
    "build:ios": "cordova build ios",
    "run:ios": "cordova run ios",
    "clean:ios": "cordova clean ios",
    "requirements": "cordova requirements ios",
    "ios": "cordova platform add ios && cordova build ios",
    "smoke": "bash scripts/smoke-gateway.sh",
    "test": "node test/supported-rails.test.js && node test/billing-tiers.test.js"
  },
  "keywords": [
    "ecosystem:cordova",
    "cordova-ios",
    "openzoo",
    "solana",
    "x402"
  ],
  "license": "MIT",
  "devDependencies": {
    "cordova": "^12.0.0",
    "cordova-ios": "^7.1.1",
    "cordova-plugin-openzoo-wallet": "file:cordova-plugin-openzoo-wallet",
    "cordova-plugin-openzoo-store": "file:cordova-plugin-openzoo-store"
  },
  "cordova": {
    "platforms": [
      "ios"
    ],
    "plugins": {
      "cordova-plugin-openzoo-wallet": {},
      "cordova-plugin-openzoo-store": {}
    }
  }
}